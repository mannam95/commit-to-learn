# Copy to .env and fill in your own values.

# --- single_repo_pr_comments.py ---
SINGLE_REPO_OWNER=your-org
SINGLE_REPO_NAME=your-repo
SINGLE_REPO_PR_NUMBER=1
SINGLE_REPO_REVIEWER=copilot-pull-request-reviewer

# --- multi_repo_pr_comments.py ---
MULTI_REPO_OWNER=your-org
MULTI_REPO_REVIEWER=copilot-pull-request-reviewer
# JSON array of [repo, pr_number] pairs. Comment out individual lines to
# exclude a repo without deleting it.
MULTI_REPO_REPOS_AND_PRS=[
    ["your-repo-a", 1],
    ["your-repo-b", 2]
]
